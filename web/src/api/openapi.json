      "Verdict": {
        "description": "What a human said about one result for one query.\n\n`MISSING` is the one that carries the most information and the only one that\ncannot be inferred from the ranking: it names a memory that *should* have\nbeen returned and was not. Precision can be measured from the first two;\nrecall cannot be measured from anything else.",
        "enum": [
          "relevant",
          "not_relevant",
          "missing"
        ],
        "title": "Verdict",
        "type": "string"
      },
      "VersionOut": {
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "is_current": {
            "title": "Is Current",
            "type": "boolean"
          },
          "normalized_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Hash"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "is_current",
          "content_hash",
          "normalized_hash",
          "ingested_at",
          "deleted_at"
        ],
        "title": "VersionOut",
        "type": "object"
      },
      "memoryos__api__routes__memories__ChunkOut": {
        "description": "One chunk, with the provenance that makes it auditable.\n\n`char_start`/`char_end` index into the parent memory's `content`, which is\nwhat lets the UI draw boundaries on the document rather than concatenating\nchunk text and hoping it lines up.",
        "properties": {
          "char_end": {
            "title": "Char End",
            "type": "integer"
          },
          "char_start": {
            "title": "Char Start",
            "type": "integer"
          },
          "chunker_version": {
            "title": "Chunker Version",
            "type": "string"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "embedded": {
            "title": "Embedded",
            "type": "boolean"
          },
          "embedded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedded At"
          },
          "embedding_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Model"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "token_count": {
            "title": "Token Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "ordinal",
          "content",
          "token_count",
          "char_start",
          "char_end",
          "chunker_version",
          "content_hash",
          "embedding_model",
          "embedded_at",
          "embedded"
        ],
        "title": "ChunkOut",
        "type": "object"
      },
      "memoryos__api__routes__search__ChunkOut": {
        "properties": {
          "breakdown": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BreakdownOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "char_end": {
            "title": "Char End",
            "type": "integer"
          },
          "char_start": {
            "title": "Char Start",
            "type": "integer"
          },
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "ordinal",
          "text",
          "score",
          "char_start",
          "char_end"
        ],
        "title": "ChunkOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Memory Intelligence OS",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/doctor": {
      "get": {
        "description": "The standing checks, rendered instead of read from a terminal.\n\nDeliberately the same `run_doctor` the CLI calls. It tokenizes candidate\nchunks with the real tokenizer, so this is not a free request \u2014 it is a\ndiagnostic somebody asked for, not something to poll.",
        "operationId": "get_doctor_doctor_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Doctor",
        "tags": [
          "stats"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/judgements": {
      "get": {
        "description": "One row per judged query, so the golden set can be watched as it grows.",
        "operationId": "list_judgements_judgements_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QuerySummaryOut"
                  },
                  "title": "Response List Judgements Judgements Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Judgements",
        "tags": [
          "judgements"
        ]
      },
      "post": {
        "description": "Record a verdict, replacing any previous one for the same query and item.",
        "operationId": "create_judgement_judgements_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JudgementIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JudgementOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Judgement",
        "tags": [
          "judgements"
        ]
      }
    },
    "/judgements/export": {
      "get": {
        "description": "The golden set as JSON. M2.0's direct input.\n\nUntyped `dict` on purpose: this is a data interchange format whose consumer\nis an evaluation harness that does not exist yet, and pinning it into a\nresponse model now would be inventing a contract for it.",
        "operationId": "export_judgements_export_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Export Judgements Export Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Export",
        "tags": [
          "judgements"
        ]
      }
    },
    "/memories": {
      "get": {
        "operationId": "list_memories_memories_get",
        "parameters": [
          {
            "in": "query",
            "name": "source_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MemoryOut"
                  },
                  "title": "Response List Memories Memories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Memories",
        "tags": [
          "sources"
        ]
      }
    },
    "/memories/{memory_id}": {
      "get": {
        "operationId": "get_memory_memories__memory_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Memory",
        "tags": [
          "memories"
        ]
      }
    },
    "/search": {
      "get": {
        "operationId": "search_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 10,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/MemoryKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "include_deleted",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Deleted",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "ef_search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ef Search"
            }
          },
          {
            "in": "query",
            "name": "exact",
            "required": false,
            "schema": {
              "default": false,
              "title": "Exact",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SearchMode",
              "default": "hybrid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search",
        "tags": [
          "search"
        ]
      },
      "post": {
        "description": "Same thing, for queries too long to sit comfortably in a URL.",
        "operationId": "search_post_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Post",
        "tags": [
          "search"
        ]
      }
    },
    "/sources": {
      "get": {
        "description": "Every source, with how much of the corpus came from it.\n\nOuter-joined and grouped rather than a count per source in a loop: the list\nis short today, but a query per row is the shape that stops being fine\nwithout anybody noticing.",
        "operationId": "list_sources_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceOut"
                  },
                  "title": "Response List Sources Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sources",
        "tags": [
          "sources"
        ]
      },
      "post": {
        "operationId": "create_source_sources_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Source",
        "tags": [
          "sources"
        ]
      }
    },
    "/sources/{source_id}/sync": {
      "post": {
        "description": "Enqueue a sync. Never runs it inline.\n\nA sync of a large directory takes minutes. Running it in the request would\nblow the HTTP timeout, and whatever it managed to do would have no retry,\nno progress, and no way to resume. 202 with a job id is the honest answer.",
        "operationId": "trigger_sync_sources__source_id__sync_post",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "full",
            "required": false,
            "schema": {
              "default": false,
              "title": "Full",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trigger Sync",
        "tags": [
          "sources"
        ]
      }
    },
    "/stats": {
      "get": {
        "operationId": "get_stats_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Stats",
        "tags": [
          "stats"
        ]
      }
    }
  }
}
