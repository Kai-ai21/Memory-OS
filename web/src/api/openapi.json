{
  "components": {
    "schemas": {
      "BreakdownOut": {
        "description": "Where the score came from, per retriever.\n\nReturned on every hit in every mode. Once two retrievers are fused into one\nnumber, that number is the only thing a client can show, and without this it\ncannot say *why* \u2014 which is both how a bad ranking gets debugged and what\nM2.5's citations will render. A null rank means that retriever did not\nreturn the chunk, which is not the same as returning it last.",
        "properties": {
          "fused": {
            "title": "Fused",
            "type": "number"
          },
          "keyword_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keyword Rank"
          },
          "keyword_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keyword Score"
          },
          "vector_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Rank"
          },
          "vector_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Score"
          }
        },
        "required": [
          "fused"
        ],
        "title": "BreakdownOut",
        "type": "object"
      },
