# `test` swaps DATABASE_URL for TEST_DATABASE_URL. The suite sets it for itself;
# setting it here would point the CLI at the database pytest empties.
MEMOS_ENVIRONMENT=local
MEMOS_DATABASE_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos
MEMOS_TEST_DATABASE_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos_test
MEMOS_BLOB_ROOT=./var/blobs
MEMOS_HF_HOME=./var/hf
MEMOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMOS_EMBEDDING_BATCH_SIZE=32
# Which provider answers (M2.6a). Both implement the same port; only the
# selected provider's key is required.
MEMOS_LLM_PROVIDER=groq
MEMOS_GROQ_API_KEY=
MEMOS_GROQ_MODEL=llama-3.3-70b-versatile

# Entity extraction (M3.1). Chunks per request: the free tier's binding limit is
# requests per day, so batching is what makes a corpus-sized run possible.
MEMOS_EXTRACTION_BATCH_SIZE=8
MEMOS_EXTRACTION_MAX_TOKENS=2048

# The graph projection (M3.0). Working defaults for `docker compose up`; the
# graph is optional, so an unreachable Neo4j degrades rather than fails.
MEMOS_NEO4J_URI=bolt://localhost:7687
MEMOS_NEO4J_USER=neo4j
MEMOS_NEO4J_PASSWORD=memoryos
MEMOS_LOG_LEVEL=INFO
MEMOS_LOG_JSON=false
MEMOS_DB_ECHO=false
