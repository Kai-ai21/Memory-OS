# `test` swaps DATABASE_URL for TEST_DATABASE_URL. The suite sets it for itself;
# setting it here would point the CLI at the database pytest empties.
MEMOS_ENVIRONMENT=local
# M11.1: the *application* role, which is not a superuser. Row-level security
# is skipped entirely for superusers and for BYPASSRLS roles, so pointing this
# at `memos` turns every policy off while leaving them all visibly in place —
# the single most likely way for this milestone to ship doing nothing.
MEMOS_DATABASE_URL=postgresql+asyncpg://memos_app:memos_app@localhost:5433/memos
# The owner, used by Alembic only: DDL needs privileges the application must
# not have.
MEMOS_DATABASE_ADMIN_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos
MEMOS_TEST_DATABASE_URL=postgresql+asyncpg://memos_app:memos_app@localhost:5433/memos_test
MEMOS_BLOB_ROOT=./var/blobs
MEMOS_HF_HOME=./var/hf
MEMOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMOS_EMBEDDING_BATCH_SIZE=32
# Which provider answers (M2.6a). Both implement the same port; only the
# selected provider's key is required.
MEMOS_LLM_PROVIDER=groq
MEMOS_GROQ_API_KEY=
MEMOS_GROQ_MODEL=openai/gpt-oss-120b

# Entity extraction (M3.1). Chunks per request: the free tier's binding limit is
# requests per day, so batching is what makes a corpus-sized run possible.
MEMOS_EXTRACTION_BATCH_SIZE=8
MEMOS_EXTRACTION_MAX_TOKENS=2048

# The graph projection (M3.0). Working defaults for `docker compose up`; the
# graph is optional, so an unreachable Neo4j degrades rather than fails.
MEMOS_NEO4J_URI=bolt://localhost:7687
MEMOS_NEO4J_USER=neo4j
MEMOS_NEO4J_PASSWORD=memoryos
MEMOS_LOG_LEVEL=INFO
MEMOS_LOG_JSON=false
MEMOS_DB_ECHO=false

# M11.2. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Nothing starts without it. Lose it and every encrypted memory is unreadable
# forever — there is no backdoor, and that is the point.
MEMOS_MASTER_KEY=
