MEMOS_ENVIRONMENT=local
MEMOS_DATABASE_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos
MEMOS_BLOB_ROOT=./var/blobs
MEMOS_HF_HOME=./var/hf
