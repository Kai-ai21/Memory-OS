# `test` swaps DATABASE_URL for TEST_DATABASE_URL. The suite sets it for itself;
# setting it here would point the CLI at the database pytest empties.
MEMOS_ENVIRONMENT=local
MEMOS_DATABASE_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos
MEMOS_TEST_DATABASE_URL=postgresql+asyncpg://memos:memos@localhost:5433/memos_test
MEMOS_BLOB_ROOT=./var/blobs
MEMOS_HF_HOME=./var/hf
MEMOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMOS_EMBEDDING_BATCH_SIZE=32
MEMOS_LOG_LEVEL=INFO
MEMOS_LOG_JSON=false
MEMOS_DB_ECHO=false
