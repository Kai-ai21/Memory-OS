# MEMO production settings (M12.3).
#
# Copy to .env.production ON THE SERVER, fill in, `chmod 600` it. It is
# gitignored and excluded from every image; it is the secret store on a single
# host. Generate secrets rather than inventing them:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"   # master key

# The public hostname. DNS must point at this server before the first start,
# so Caddy can obtain a certificate.
MEMO_DOMAIN=

# Every memory is encrypted under this. Lose it and the data is gone; keep a
# copy somewhere that is not this server and not its backups.
MEMOS_MASTER_KEY=

# The Postgres superuser (migrations, backups) and the application's own role
# (everything else; not a superuser, so row-level security applies to it).
POSTGRES_PASSWORD=
MEMOS_APP_DB_PASSWORD=

MEMOS_NEO4J_PASSWORD=

# Off unless you mean it: with it on, anyone who finds the URL can make an account.
MEMOS_ALLOW_REGISTRATION=false

# Optional: answers need a language model. Without a key, search still works.
MEMOS_LLM_PROVIDER=groq
MEMOS_GROQ_API_KEY=
MEMOS_GROQ_MODEL=openai/gpt-oss-120b

# Optional: backups default to ./backups, nightly, 14 kept.
# MEMO_BACKUP_DIR=/var/backups/memo
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=14
