{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(~/Documents/**)",
      "Read(~/Library/**)",
      "Read(/Volumes/**)",
      "Read(~/Desktop/IOM/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(brew:*)",
      "Bash(defaults:*)",
      "Bash(launchctl:*)",
      "Bash(tccutil:*)",
      "Bash(diskutil:*)",
      "Bash(security:*)",
      "Bash(crontab:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ],
    "ask": [],
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(*)"
    ]
  }
}
